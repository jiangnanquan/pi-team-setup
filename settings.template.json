{
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "max",
    "deepseek/deepseek-v4-flash-vision-exp": "max"
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "enableSkillCommands": true,
  "showHardwareCursor": true,
  "collapseChangelog": true,
  "quietStartup": true,
  "powerline": {
    "placement": "below",
    "cost": {
      "currency": "CNY"
    },
    "disabledSegments": [
      "context_pct",
      "cache_read"
    ],
    "layout": {
      "left": [
        "path",
        "git",
        "model",
        "thinking",
        "shell_mode",
        "custom:context-bar",
        "cost",
        "custom:ds-balance"
      ],
      "right": [
        "custom:cache-hit",
        "custom:tps",
        "queue"
      ]
    },
    "customItems": [
      {
        "id": "context-bar",
        "statusKey": "context-bar",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "tps",
        "statusKey": "tps",
        "position": "right",
        "prefix": "⚡",
        "color": "accent"
      },
      {
        "id": "cache-hit",
        "statusKey": "cache-hit",
        "position": "right",
        "selfColorize": true
      },
      {
        "id": "ds-balance",
        "statusKey": "ds-balance",
        "position": "right",
        "selfColorize": true
      }
    ]
  }
}
